# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.
# Never put the Supabase service-role / secret key in this app.

# Supabase project (local: `supabase status` prints both; hosted: Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin of this app, used for OAuth and email redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Product identity (temporary name; keep configurable)
NEXT_PUBLIC_APP_NAME=Beta
NEXT_PUBLIC_APP_TAGLINE=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=

# Local development only: email-link sign-in for seeded users (alice/bob/carol@example.test)
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
